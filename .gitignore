# Machine-specific tools, signing keys and device configuration
/.local/
/dist/
/node_modules/
.DS_Store
__pycache__/
*.pyc
.env
.env.*
*.p12
*.pem
*.key
*.csr
profiles.xml
session.json
certificate-password.txt

# Proprietary fonts are injected from .local/ at preview/package time.
/app/assets/private-fonts/
PP*.ttf
PP*.otf
PP*.woff
PP*.woff2
*.wgt

# Personal studies, research and draft writing stay local.
/explorations/
/docs/research/
/docs/articles/

# Personal wallpaper art. Curious George is protected character artwork:
# fine on your own TV, not something to redistribute from a public repo.
# The catalogue entries that reference these files are deliberately left
# uncommitted too, so a clean clone still passes `npm run check`.
/app/assets/wallpapers/curious*.jpg
/app/assets/materials/curious-*.jpg
